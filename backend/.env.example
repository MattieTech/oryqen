# ORYQEN Environment Configuration
# Primary Cloud Neural Engine (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Resilient Cloud Backup Engine 1 (OpenRouter - Failover for Rate Limits & Quotas)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Resilient Cloud Backup Engine 2 (OpenAI - Secondary Failover)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Supabase Managed PostgreSQL & pgvector (Remote Sync & Authentication)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Server Host & Port
HOST=127.0.0.1
PORT=8000
